# Firebase Admin SDK credentials for server-authoritative economy, leaderboard & custom claims.
# Provide either a raw JSON string or base64-encoded service account JSON:
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Alternatively, point Google Application Default Credentials to a service account key file:
GOOGLE_APPLICATION_CREDENTIALS=""

# Optional comma-separated allowed WebSocket origins (defaults to same-host matches):
ALLOWED_ORIGINS=""

# Optional one-time secret for promoting the first admin account via POST /api/admin/bootstrap-claim:
ADMIN_BOOTSTRAP_SECRET=""
