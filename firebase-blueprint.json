{
  "entities": {
    "User": {
      "title": "User",
      "description": "Private authenticated player profile, wallet, inventory, and progression stats in PFA 27",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the player",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "Display name of the pen fight player",
          "minLength": 1,
          "maxLength": 64
        },
        "email": {
          "type": "string",
          "description": "Private verified email address of the player (owner/admin only)",
          "minLength": 3,
          "maxLength": 256
        },
        "level": {
          "type": "number",
          "description": "Current player level (1 to 100)"
        },
        "xp": {
          "type": "number",
          "description": "Current player experience points"
        },
        "xpNextLevel": {
          "type": "number",
          "description": "XP threshold required for next level"
        },
        "paperclips": {
          "type": "number",
          "description": "Current balance of earned paperclips (0 to 999999)"
        },
        "division": {
          "type": "number",
          "description": "Current competitive division (10 down to 1)"
        },
        "divisionPoints": {
          "type": "number",
          "description": "Current division rank points (0 to 100)"
        },
        "totalWins": {
          "type": "number",
          "description": "Total ranked/tournament matches won"
        },
        "totalMatches": {
          "type": "number",
          "description": "Total matches played"
        },
        "winStreak": {
          "type": "number",
          "description": "Current consecutive ranked win streak"
        },
        "equippedPenId": {
          "type": "string",
          "description": "ID of currently equipped pen",
          "maxLength": 64
        },
        "equippedSkinId": {
          "type": "string",
          "description": "ID of currently equipped pen skin",
          "maxLength": 64
        },
        "equippedFlickStyleId": {
          "type": "string",
          "description": "ID of currently equipped finger-flicking style",
          "maxLength": 64
        },
        "unlockedPens": {
          "type": "array",
          "description": "List of unlocked real pen brand IDs (max 50)"
        },
        "unlockedSkins": {
          "type": "array",
          "description": "List of unlocked geometry box skin IDs (max 100)"
        },
        "unlockedFlickStyles": {
          "type": "array",
          "description": "List of unlocked flicking style IDs (max 20)"
        },
        "role": {
          "type": "string",
          "enum": ["ADMIN", "PLAYER"],
          "description": "Role and privileges of the player"
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Whether the user has developer/admin privileges"
        },
        "platform": {
          "type": "string",
          "enum": ["mobile", "desktop"],
          "description": "Player's active device platform"
        },
        "crossplaySetting": {
          "type": "string",
          "enum": ["CROSSPLAY_ENABLED", "SAME_PLATFORM_ONLY"],
          "description": "Player's matchmaking crossplay preference"
        },
        "tutorialCompleted": {
          "type": "boolean",
          "description": "Whether the one-time Academy graduation reward has been claimed"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of profile creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last profile update"
        }
      },
      "required": [
        "userId",
        "username",
        "email",
        "level",
        "xp",
        "xpNextLevel",
        "paperclips",
        "division",
        "divisionPoints",
        "totalWins",
        "totalMatches",
        "winStreak",
        "equippedPenId",
        "equippedSkinId",
        "equippedFlickStyleId",
        "unlockedPens",
        "unlockedSkins",
        "unlockedFlickStyles",
        "role",
        "isAdmin",
        "platform",
        "crossplaySetting",
        "tutorialCompleted",
        "createdAt",
        "updatedAt"
      ]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public, PII-free competitive ranking projection for global human leaderboards",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the ranked player",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "Public display name",
          "minLength": 1,
          "maxLength": 64
        },
        "division": {
          "type": "number",
          "description": "Current competitive division (10 down to 1)"
        },
        "divisionPoints": {
          "type": "number",
          "description": "Current division points (0 to 100)"
        },
        "totalWins": {
          "type": "number",
          "description": "Total competitive wins"
        },
        "totalMatches": {
          "type": "number",
          "description": "Total matches played"
        },
        "winStreak": {
          "type": "number",
          "description": "Current ranked win streak"
        },
        "equippedPenId": {
          "type": "string",
          "description": "Currently equipped pen ID",
          "maxLength": 64
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Verified developer admin badge flag"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last ranking synchronization timestamp"
        }
      },
      "required": [
        "userId",
        "username",
        "division",
        "divisionPoints",
        "totalWins",
        "totalMatches",
        "winStreak",
        "equippedPenId",
        "isAdmin",
        "updatedAt"
      ]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Official PFA 27 developer news, patch notes, and tournament announcements",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Headline of the news post",
          "minLength": 1,
          "maxLength": 140
        },
        "content": {
          "type": "string",
          "description": "Full announcement body text",
          "minLength": 1,
          "maxLength": 3000
        },
        "category": {
          "type": "string",
          "enum": ["PATCH_NOTES", "TOURNAMENT", "FEATURE", "ANNOUNCEMENT"],
          "description": "Category tag for the news post"
        },
        "pinned": {
          "type": "boolean",
          "description": "Whether the post is pinned to the top of the news feed"
        },
        "authorName": {
          "type": "string",
          "description": "Display name of the admin author",
          "minLength": 1,
          "maxLength": 64
        },
        "authorUid": {
          "type": "string",
          "description": "Firebase Auth UID of the admin author",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the announcement was published"
        }
      },
      "required": [
        "title",
        "content",
        "category",
        "pinned",
        "authorName",
        "authorUid",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Private individual player account profile, paperclip wallet, email, and pen collection (owner and admin read only)"
    },
    "/leaderboard/{userId}": {
      "schema": {
        "$ref": "#/entities/LeaderboardEntry"
      },
      "description": "Public PII-free competitive leaderboard entries atomically synchronized with /users/{userId}"
    },
    "/announcements/{announcementId}": {
      "schema": {
        "$ref": "#/entities/Announcement"
      },
      "description": "Official developer news and announcements"
    }
  }
}
