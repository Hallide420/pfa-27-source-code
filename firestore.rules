rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Hardened Admin Verification: verified email token + exact bootstrapped admin email
    function isAdmin() {
      return isVerifiedUser() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == 'samwdoesthings@gmail.com';
    }

    function isValidUser(data) {
      return data.keys().hasAll([
        'userId', 'username', 'email', 'level', 'xp', 'xpNextLevel',
        'paperclips', 'division', 'divisionPoints', 'totalWins', 'totalMatches',
        'winStreak', 'equippedPenId', 'equippedSkinId', 'equippedFlickStyleId',
        'unlockedPens', 'unlockedSkins', 'unlockedFlickStyles',
        'role', 'isAdmin', 'platform', 'crossplaySetting', 'tutorialCompleted',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'userId', 'username', 'email', 'level', 'xp', 'xpNextLevel',
        'paperclips', 'division', 'divisionPoints', 'totalWins', 'totalMatches',
        'winStreak', 'equippedPenId', 'equippedSkinId', 'equippedFlickStyleId',
        'unlockedPens', 'unlockedSkins', 'unlockedFlickStyles',
        'role', 'isAdmin', 'platform', 'crossplaySetting', 'tutorialCompleted',
        'createdAt', 'updatedAt'
      ]) &&
      data.userId is string && data.userId == request.auth.uid && isValidId(data.userId) &&
      data.username is string && data.username.size() > 0 && data.username.size() <= 64 &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 256 &&
      data.level is number && data.level >= 1 && data.level <= 100 &&
      data.xp is number && data.xp >= 0 && data.xp <= 10000000 &&
      data.xpNextLevel is number && data.xpNextLevel >= 100 && data.xpNextLevel <= 10000000 &&
      data.paperclips is number && data.paperclips >= 0 && data.paperclips <= 999999 &&
      data.division is number && data.division >= 1 && data.division <= 10 &&
      data.divisionPoints is number && data.divisionPoints >= 0 && data.divisionPoints <= 100 &&
      data.totalWins is number && data.totalWins >= 0 && data.totalWins <= 100000 &&
      data.totalMatches is number && data.totalMatches >= 0 && data.totalMatches <= 100000 &&
      data.totalWins <= data.totalMatches &&
      data.winStreak is number && data.winStreak >= 0 && data.winStreak <= data.totalWins &&
      data.equippedPenId is string && data.equippedPenId.size() > 0 && data.equippedPenId.size() <= 64 &&
      data.equippedSkinId is string && data.equippedSkinId.size() > 0 && data.equippedSkinId.size() <= 64 &&
      data.equippedFlickStyleId is string && data.equippedFlickStyleId.size() > 0 && data.equippedFlickStyleId.size() <= 64 &&
      data.unlockedPens is list && data.unlockedPens.size() >= 1 && data.unlockedPens.size() <= 50 && data.unlockedPens[0] is string &&
      data.unlockedSkins is list && data.unlockedSkins.size() >= 1 && data.unlockedSkins.size() <= 100 && data.unlockedSkins[0] is string &&
      data.unlockedFlickStyles is list && data.unlockedFlickStyles.size() >= 1 && data.unlockedFlickStyles.size() <= 20 && data.unlockedFlickStyles[0] is string &&
      data.equippedPenId in data.unlockedPens &&
      data.equippedSkinId in data.unlockedSkins &&
      data.equippedFlickStyleId in data.unlockedFlickStyles &&
      data.role is string && (data.role == 'PLAYER' || (data.role == 'ADMIN' && isAdmin())) &&
      data.isAdmin is bool && (data.isAdmin == false || (data.isAdmin == true && isAdmin())) &&
      data.platform is string && data.platform in ['mobile', 'desktop'] &&
      data.crossplaySetting is string && data.crossplaySetting in ['CROSSPLAY_ENABLED', 'SAME_PLATFORM_ONLY'] &&
      data.tutorialCompleted is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidStarterUser(data) {
      return data.role == 'PLAYER' &&
        data.isAdmin == false &&
        data.level == 1 &&
        data.xp == 0 &&
        data.xpNextLevel == 100 &&
        data.paperclips <= 240 &&
        data.division == 10 &&
        data.divisionPoints <= 20 &&
        data.totalWins == 0 &&
        data.totalMatches == 0 &&
        data.winStreak == 0 &&
        data.unlockedPens.size() <= 2 &&
        data.unlockedSkins.size() <= 2 &&
        data.unlockedFlickStyles.size() <= 1 &&
        data.tutorialCompleted == false;
    }

    function prevPaperclips() {
      return 'paperclips' in existing() ? existing().paperclips : 240;
    }

    function prevXp() {
      return 'xp' in existing() ? existing().xp : 0;
    }

    function prevLevel() {
      return 'level' in existing() ? existing().level : 1;
    }

    function prevDivision() {
      return 'division' in existing() ? existing().division : 10;
    }

    function prevTotalMatches() {
      return 'totalMatches' in existing() ? existing().totalMatches : 0;
    }

    function prevTotalWins() {
      return 'totalWins' in existing() ? existing().totalWins : 0;
    }

    function prevUnlockedPensCount() {
      return 'unlockedPens' in existing() ? existing().unlockedPens.size() : 2;
    }

    function prevUnlockedSkinsCount() {
      return 'unlockedSkins' in existing() ? existing().unlockedSkins.size() : 2;
    }

    function prevUnlockedStylesCount() {
      return 'unlockedFlickStyles' in existing() ? existing().unlockedFlickStyles.size() : 1;
    }

    function isValidPlayerProgressionUpdate() {
      return incoming().role == 'PLAYER' &&
        incoming().isAdmin == false &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'username', 'level', 'xp', 'xpNextLevel', 'paperclips',
          'division', 'divisionPoints', 'totalWins', 'totalMatches', 'winStreak',
          'equippedPenId', 'equippedSkinId', 'equippedFlickStyleId',
          'unlockedPens', 'unlockedSkins', 'unlockedFlickStyles',
          'platform', 'crossplaySetting', 'tutorialCompleted', 'createdAt', 'updatedAt'
        ]) &&
        incoming().paperclips <= prevPaperclips() + 120 &&
        incoming().xp <= prevXp() + 200 &&
        incoming().level >= prevLevel() &&
        incoming().level <= prevLevel() + 1 &&
        incoming().division <= prevDivision() &&
        incoming().division >= prevDivision() - 1 &&
        incoming().totalMatches >= prevTotalMatches() &&
        incoming().totalMatches <= prevTotalMatches() + 1 &&
        incoming().totalWins >= prevTotalWins() &&
        incoming().totalWins <= prevTotalWins() + 1 &&
        (incoming().totalWins == prevTotalWins() || incoming().totalMatches == prevTotalMatches() + 1) &&
        incoming().unlockedPens.size() >= prevUnlockedPensCount() &&
        incoming().unlockedPens.size() <= prevUnlockedPensCount() + 3 &&
        incoming().unlockedSkins.size() >= prevUnlockedSkinsCount() &&
        incoming().unlockedSkins.size() <= prevUnlockedSkinsCount() + 1 &&
        incoming().unlockedFlickStyles.size() >= prevUnlockedStylesCount() &&
        incoming().unlockedFlickStyles.size() <= prevUnlockedStylesCount() + 2 &&
        (!('tutorialCompleted' in existing()) || existing().tutorialCompleted == false || incoming().tutorialCompleted == true);
    }

    // Private User Profile Document Path (PII Isolated: email & wallet strictly owner/admin)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUser(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (isAdmin() || isValidStarterUser(incoming()));

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUser(incoming()) &&
        incoming().userId == existing().userId &&
        (!('email' in existing()) || incoming().email == existing().email) &&
        (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
        incoming().updatedAt == request.time &&
        (isAdmin() || isValidPlayerProgressionUpdate());

      allow delete: if false;
    }

    function isValidLeaderboardEntry(data, userId) {
      return data.keys().hasAll([
        'userId', 'username', 'division', 'divisionPoints',
        'totalWins', 'totalMatches', 'winStreak', 'equippedPenId',
        'isAdmin', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'userId', 'username', 'division', 'divisionPoints',
        'totalWins', 'totalMatches', 'winStreak', 'equippedPenId',
        'isAdmin', 'updatedAt'
      ]) &&
      data.userId is string && data.userId == request.auth.uid && data.userId == userId && isValidId(data.userId) &&
      data.username is string && data.username.size() > 0 && data.username.size() <= 64 &&
      data.division is number && data.division >= 1 && data.division <= 10 &&
      data.divisionPoints is number && data.divisionPoints >= 0 && data.divisionPoints <= 100 &&
      data.totalWins is number && data.totalWins >= 0 && data.totalWins <= 100000 &&
      data.totalMatches is number && data.totalMatches >= 0 && data.totalMatches <= 100000 &&
      data.totalWins <= data.totalMatches &&
      data.winStreak is number && data.winStreak >= 0 && data.winStreak <= data.totalWins &&
      data.equippedPenId is string && data.equippedPenId.size() > 0 && data.equippedPenId.size() <= 64 &&
      data.isAdmin is bool && (data.isAdmin == false || (data.isAdmin == true && isAdmin())) &&
      data.updatedAt is timestamp &&
      data.updatedAt == request.time &&
      existsAfter(/databases/$(database)/documents/users/$(userId)) &&
      getAfter(/databases/$(database)/documents/users/$(userId)).data.division == data.division &&
      getAfter(/databases/$(database)/documents/users/$(userId)).data.totalWins == data.totalWins &&
      getAfter(/databases/$(database)/documents/users/$(userId)).data.isAdmin == data.isAdmin;
    }

    // Public PII-Free Competitive Leaderboard Projection
    match /leaderboard/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() &&
        resource.data.userId is string &&
        resource.data.division >= 1 &&
        resource.data.division <= 10;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidLeaderboardEntry(incoming(), userId);

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidLeaderboardEntry(incoming(), userId) &&
        incoming().userId == existing().userId;

      allow delete: if false;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll([
        'title', 'content', 'category', 'pinned', 'authorName', 'authorUid', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'title', 'content', 'category', 'pinned', 'authorName', 'authorUid', 'createdAt'
      ]) &&
      data.title is string && data.title.size() > 0 && data.title.size() <= 140 &&
      data.content is string && data.content.size() > 0 && data.content.size() <= 3000 &&
      data.category is string && data.category in ['PATCH_NOTES', 'TOURNAMENT', 'FEATURE', 'ANNOUNCEMENT'] &&
      data.pinned is bool &&
      data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 64 &&
      data.authorUid is string && data.authorUid == request.auth.uid && isValidId(data.authorUid) &&
      data.createdAt is timestamp;
    }

    // Official Developer News & Announcements
    match /announcements/{announcementId} {
      allow get: if isSignedIn() && isValidId(announcementId);
      allow list: if isSignedIn() &&
        resource.data.title is string &&
        resource.data.category in ['PATCH_NOTES', 'TOURNAMENT', 'FEATURE', 'ANNOUNCEMENT'];

      allow create: if isAdmin() &&
        isValidId(announcementId) &&
        isValidAnnouncement(incoming()) &&
        incoming().createdAt == request.time;

      allow update: if isAdmin() &&
        isValidId(announcementId) &&
        isValidAnnouncement(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'category', 'pinned']) &&
        incoming().authorUid == existing().authorUid &&
        incoming().createdAt == existing().createdAt;

      allow delete: if isAdmin() && isValidId(announcementId);
    }
  }
}
